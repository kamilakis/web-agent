#!/usr/bin/env python3
"""Always-on pi agent session, driven over a FIFO, answers posted to Matrix.

One persistent `pi --mode rpc` process holds a single long-lived session (fixed
session id => full memory across restarts). Prompts arrive as lines on a FIFO;
each prompt is sent to the agent, and when the agent settles, its final message
is posted to the Matrix room via `matrix-notify`.

Prompts are processed strictly one at a time: the next queued prompt is only
sent after the previous one settles, so there is exactly one Matrix reply per
command.

Env overrides:
  AGENT_SESSION_DIR   state dir (default ~/.local/share/agent-session)
  AGENT_SESSION_WORKDIR   pi working dir (default ~/assistant)
  AGENT_SESSION_ID    pi session id (default "siri-agent")
  AGENT_PROVIDER      pi --provider (default "anthropic")
  AGENT_MODEL         pi --model (default "claude-opus-4-8")
  AGENT_QUIET_MATRIX  if "1", do not post; just log (for testing)
"""
import os
import sys
import json
import time
import queue
import shutil
import base64
import signal
import threading
import subprocess
import urllib.parse
import mimetypes
from datetime import datetime, timezone
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

HOME = os.path.expanduser("~")
STATE = os.environ.get("AGENT_SESSION_DIR", f"{HOME}/.local/share/agent-session")
WORKDIR = os.environ.get("AGENT_SESSION_WORKDIR", f"{HOME}/assistant")
SESSION_ID = os.environ.get("AGENT_SESSION_ID", "siri-agent")
SESSION_NAME = os.environ.get("AGENT_SESSION_NAME", "siri-agent")
PROVIDER = os.environ.get("AGENT_PROVIDER", "deepseek")
MODEL = os.environ.get("AGENT_MODEL", "deepseek-v4-pro")
QUIET = os.environ.get("AGENT_QUIET_MATRIX") == "1"

# How long a synchronous caller (Siri) is allowed to wait before the answer
# falls back to Matrix. Must be comfortably longer than the waiter's poll window.
GRACE = int(os.environ.get("AGENT_SETTLE_GRACE", "30"))

# Appended to every prompt so answers are sized for being spoken aloud.
VOICE_HINT = os.environ.get(
    "AGENT_VOICE_HINT",
    "\n\n(Reply concisely — your answer is spoken back by Siri, so keep it to a "
    "few short sentences.)",
)

FIFO = os.path.join(STATE, "in.fifo")
TASKS = os.path.join(STATE, "tasks")
LOG = os.path.join(STATE, "daemon.log")
SESSIONS_DIR = os.path.join(STATE, "sessions")
ARCHIVE_DIR = os.path.join(STATE, "archive")
# Part C: a deleted transcript is MOVED here, not unlinked, and the janitor
# empties it after AGENT_TRASH_DAYS. Nothing lists this directory.
TRASH_DIR = os.path.join(STATE, "trash")
# Which transcript pi is currently on, as an absolute path. Written on every
# session switch and at startup, read by start_pi() — see resume_target().
ACTIVE_FILE = os.path.join(STATE, "active-session")

# Web dashboard (SSE + HTTP control plane). WireGuard-only by default.
WEB_ENABLED = os.environ.get("AGENT_WEB_ENABLED", "1") != "0"
WEB_HOST = os.environ.get("AGENT_WEB_HOST", "127.0.0.1")
WEB_PORT = int(os.environ.get("AGENT_WEB_PORT", "8383"))
WEB_TOKEN = os.environ.get("AGENT_WEB_TOKEN") or None
INDEX_PATH = os.path.join(STATE, "web", "index.html")

# Cap HTTP request bodies (a downscaled chat photo is a few hundred KB; this is
# abuse protection, not a feature limit).
MAX_BODY = int(os.environ.get("AGENT_WEB_MAX_BODY", str(12 * 1024 * 1024)))

# §15 image editing: incoming images are saved here so the agent's tools (ffmpeg,
# not the vision model) can edit them, and /media serves this tree back to the
# dashboard. HINT_MARK marks the plumbing appended to the prompt; /messages and
# the SSE broadcast strip everything from it so transcripts stay clean.
ATTACH_DIR = os.environ.get("AGENT_ATTACH_DIR", os.path.join(STATE, "attachments"))
HINT_MARK = "\n\n[attached files on disk: "
IMG_EXT = {"image/jpeg": ".jpg", "image/png": ".png",
           "image/webp": ".webp", "image/gif": ".gif"}
IMG_EXTS = (".png", ".jpg", ".jpeg", ".webp", ".gif")
os.makedirs(os.path.join(ATTACH_DIR, "in"), exist_ok=True)
os.makedirs(os.path.join(ATTACH_DIR, "out"), exist_ok=True)

# Messages in a /messages snapshot, and the cap on one tool result's text.
MSG_SNAPSHOT = int(os.environ.get("AGENT_WEB_MSG_LIMIT", "50"))
TOOL_RESULT_CAP = int(os.environ.get("AGENT_WEB_TOOL_CAP", "2048"))

# Vision model auto-selected when a picture is attached (deepseek-v4-pro is
# text-only). Format "provider/modelId".
VISION_MODEL = os.environ.get("AGENT_VISION_MODEL", "deepseek/deepseek-v4-flash-vision-exp")
VISION_PROVIDER, VISION_MODEL_ID = VISION_MODEL.split("/", 1)

# A dispatched prompt should produce agent_start within milliseconds. If none
# arrives (an extension command that starts no run, or a failure after pi's
# preflight already answered success) the pending flag would stall the FIFO
# forever, so a watchdog clears it and a janitor thread re-checks periodically.
DISPATCH_TIMEOUT = int(os.environ.get("AGENT_DISPATCH_TIMEOUT", "30"))
JANITOR_INTERVAL = int(os.environ.get("AGENT_JANITOR_INTERVAL", "15"))
TRASH_DAYS = int(os.environ.get("AGENT_TRASH_DAYS", "30"))

# §20 usage: transcript totals refresh often (they are read from a local file);
# an account balance is a slow, rate-limited API call and is only re-read when
# it goes stale or the provider changes.
USAGE_REFRESH = int(os.environ.get("AGENT_USAGE_REFRESH", "30"))
USAGE_INTERVAL = int(os.environ.get("AGENT_USAGE_INTERVAL", "900"))
USAGE_CMD = os.environ.get("AGENT_USAGE_CMD", "")

# §21 approval gate: how long a question from an extension may wait for an
# answer, and how long to wait for a dashboard to appear at all before giving
# up. The old code cancelled every dialog instantly ("v1 auto-cancels") because
# nothing could answer it; now the dashboard can, but a run must still never
# hang forever on a phone that is not looking.
UI_TIMEOUT = int(os.environ.get("AGENT_UI_TIMEOUT", "90"))
UI_NOUI_GRACE = int(os.environ.get("AGENT_UI_NOUI_GRACE", "15"))

# What this build is. Bump DAEMON_VERSION with every daemon change: the
# dashboard shows it next to its own UI_VERSION, so a page running against a
# stale daemon (which is how "resume needs a daemon restart" happens) is
# visible instead of guessed at. install.sh records the git commit alongside.
DAEMON_VERSION = "2026-09-26.4"
BUILD_FILE = os.path.join(STATE, "build.json")
MAX_PROMPT_ATTEMPTS = int(os.environ.get("AGENT_MAX_PROMPT_ATTEMPTS", "3"))

os.makedirs(STATE, exist_ok=True)
os.makedirs(ARCHIVE_DIR, exist_ok=True)
os.makedirs(TRASH_DIR, exist_ok=True)


def _text_of(content):
    """Concatenated text of a message's content (string or block list)."""
    if isinstance(content, str):
        return content
    if isinstance(content, list):
        return "\n".join(x.get("text") or "" for x in content
                        if isinstance(x, dict) and x.get("type") == "text")
    return ""


def _clean_user_text(t):
    """Strip plumbing the daemon appends (Siri voice hint, attachment paths):
    transcripts should show only what the user typed."""
    if VOICE_HINT and t.endswith(VOICE_HINT):
        t = t[:-len(VOICE_HINT)].rstrip()
    if HINT_MARK in t:
        t = t.split(HINT_MARK)[0].rstrip()
    return t


def session_meta(path, which):
    """Sidebar metadata for one session file: id, display name, title (first
    user text), user+assistant message count, timestamps. Streaming read; a
    torn tail line (pi appending right now) is skipped."""
    info = {"name": os.path.basename(path), "dir": which, "title": None,
            "count": 0, "started": None, "id": None, "sessionName": None}
    try:
        with open(path, "r", encoding="utf-8", errors="replace") as f:
            for line in f:
                line = line.strip()
                if not line:
                    continue
                try:
                    e = json.loads(line)
                except Exception:
                    continue
                t = e.get("type")
                if t == "session":
                    info["id"] = e.get("id")
                    info["started"] = e.get("timestamp")
                elif t == "session_info":
                    info["sessionName"] = e.get("name")
                elif t == "message":
                    m = e.get("message") or {}
                    if m.get("role") in ("user", "assistant"):
                        info["count"] += 1
                    if m.get("role") == "user" and not info["title"]:
                        txt = _clean_user_text(_text_of(m.get("content"))).strip()
                        if txt:
                            info["title"] = txt[:120]
        st = os.stat(path)
        info["size"] = st.st_size
        info["mtime"] = int(st.st_mtime)
    except OSError:
        return None
    if not info["title"]:
        info["title"] = info["sessionName"] or info["name"]
    return info


def _usage_of(msg):
    """The usage block pi wrote on an assistant message, or None.

    pi records this for every provider (it is how the TUI shows cost), so a
    transcript is a provider-agnostic source of what has actually been spent —
    no API key, no per-provider code. A provider that reports nothing simply
    yields no totals.
    """
    u = msg.get("usage")
    if not isinstance(u, dict):
        return None
    cost = u.get("cost") if isinstance(u.get("cost"), dict) else {}
    total = cost.get("total")
    return {
        "input": u.get("input") or 0,
        "output": u.get("output") or 0,
        "cache_read": u.get("cacheRead") or 0,
        "cache_write": u.get("cacheWrite") or 0,
        "cost": float(total) if isinstance(total, (int, float)) else None,
    }


def _ts_seconds(ts):
    """pi timestamps are epoch ms; older files may carry seconds."""
    if not isinstance(ts, (int, float)) or ts <= 0:
        return None
    return ts / 1000.0 if ts > 1e11 else float(ts)


def transcript_usage(path, day_start=None):
    """Token and cost totals from one transcript (see _usage_of).

    `day_start` splits out today's share, which is the number that answers
    "what has this cost me lately" — the session total only ever grows.
    """
    tot = {"messages": 0, "input": 0, "output": 0, "cache_read": 0,
           "cache_write": 0, "cost": 0.0, "unpriced": 0}
    day = {"messages": 0, "input": 0, "output": 0, "cost": 0.0}
    models = {}
    try:
        with open(path, "r", encoding="utf-8", errors="replace") as f:
            for line in f:
                line = line.strip()
                if not line:
                    continue
                try:
                    e = json.loads(line)
                except Exception:
                    continue
                if e.get("type") != "message":
                    continue
                m = e.get("message") or {}
                if m.get("role") != "assistant":
                    continue
                u = _usage_of(m)
                if not u:
                    continue
                tot["messages"] += 1
                tot["input"] += u["input"]
                tot["output"] += u["output"]
                tot["cache_read"] += u["cache_read"]
                tot["cache_write"] += u["cache_write"]
                if u["cost"] is None:
                    tot["unpriced"] += 1
                else:
                    tot["cost"] += u["cost"]
                if m.get("model"):
                    models[m["model"]] = models.get(m["model"], 0) + 1
                ts = _ts_seconds(m.get("timestamp"))
                if day_start and ts and ts >= day_start:
                    day["messages"] += 1
                    day["input"] += u["input"]
                    day["output"] += u["output"]
                    day["cost"] += u["cost"] or 0.0
    except OSError:
        return None
    tot["cost"] = round(tot["cost"], 4)
    day["cost"] = round(day["cost"], 4)
    tot["models"] = models
    return {"session": tot, "today": day}


def session_messages(path, cap=4000):
    """A past session file -> {messages: [...]} in the same shape as the live
    /messages snapshot (thinking stripped, tool results capped, image blobs
    dropped), so the dashboard renders history with the same renderer."""
    out = []
    with open(path, "r", encoding="utf-8", errors="replace") as f:
        for line in f:
            line = line.strip()
            if not line:
                continue
            try:
                e = json.loads(line)
            except Exception:
                continue
            if e.get("type") != "message":
                continue
            m = e.get("message") or {}
            role = m.get("role")
            content = m.get("content")
            if role == "user":
                if isinstance(content, str):
                    content = [{"type": "text",
                                "text": _clean_user_text(content)}]
                elif isinstance(content, list):
                    blocks = []
                    for x in content:
                        if not isinstance(x, dict):
                            continue
                        if x.get("type") == "text":
                            blocks.append({**x, "text": _clean_user_text(
                                x.get("text") or "")})
                        # image blobs are dropped: the page that sent them
                        # rendered them already; /media keeps the originals
                    content = blocks
                else:
                    continue
            elif role == "assistant":
                if isinstance(content, list):
                    content = [x for x in content
                               if isinstance(x, dict)
                               and x.get("type") != "thinking"]
                else:
                    continue
            elif role == "toolResult":
                if isinstance(content, list):
                    blocks = []
                    for x in content:
                        if not isinstance(x, dict) or x.get("type") != "text":
                            continue   # image blobs are dropped: the live view
                                       # does the same; /media keeps originals
                        t2 = x.get("text") or ""
                        if len(t2) > TOOL_RESULT_CAP:
                            x = {**x, "text": t2[:TOOL_RESULT_CAP] + "…"}
                        blocks.append(x)
                    content = blocks
                else:
                    continue
            else:
                continue
            # §8 L6: without the call id the dashboard cannot pair a result with
            # the row that made it, so it invents a separate "result" row.
            entry = {"role": role, "content": content}
            if role == "toolResult":
                if m.get("toolCallId"):
                    entry["toolCallId"] = m.get("toolCallId")
                if m.get("toolName"):
                    entry["toolName"] = m.get("toolName")
                entry["isError"] = bool(m.get("isError"))
            out.append(entry)
            if len(out) >= cap:
                break
    return {"messages": out}


def _valid_session_file(path):
    """A file pi can actually resume: a readable JSONL whose first line is a
    session header. Guarding this matters because a resume target that makes pi
    exit on startup would turn into a restart loop with systemd."""
    try:
        if os.path.getsize(path) == 0:
            return False
        with open(path, encoding="utf-8", errors="replace") as f:
            first = f.readline().strip()
        return (json.loads(first) or {}).get("type") == "session"
    except (OSError, ValueError):
        return False


def _newest_session_file():
    """The most recently written transcript for SESSION_ID, or None. Used only
    when there is no usable active-session record."""
    try:
        names = [n for n in os.listdir(SESSIONS_DIR)
                 if n.endswith(f"_{SESSION_ID}.jsonl")]
    except OSError:
        return None
    paths = [os.path.join(SESSIONS_DIR, n) for n in names
             if _valid_session_file(os.path.join(SESSIONS_DIR, n))]
    if not paths:
        return None
    return max(paths, key=lambda p: os.path.getmtime(p))


def build_info():
    """This daemon's version, plus the commit install.sh recorded in
    $AGENT_SESSION_DIR/build.json. A missing build file is not an error —
    a hand-copied daemon just reports its version alone."""
    info = {"daemon": DAEMON_VERSION, "commit": None, "built": None}
    try:
        with open(BUILD_FILE, encoding="utf-8") as f:
            d = json.load(f)
        if isinstance(d, dict):
            info["commit"] = d.get("commit") or None
            info["built"] = d.get("built") or None
    except (OSError, ValueError):
        pass
    return info


BIN_DIR = os.path.dirname(os.path.abspath(__file__))


def find_bin(name, env_var=None):
    """Locate a helper binary without trusting the ambient PATH.

    The daemon and its helpers (pi, matrix-notify, agent-task) are installed
    side by side in ~/.local/bin — but a `systemctl --user` unit started at boot
    with linger enabled, before any login has imported the environment, gets
    systemd's default PATH, which does NOT include ~/.local/bin. A bare "pi"
    therefore raised FileNotFoundError at 2026-09-21 11:07:26, and the service
    only came up because systemd retried six seconds later, once a graphical
    login had imported the real environment. Look next to ourselves first.
    """
    override = os.environ.get(env_var) if env_var else None
    if override:
        return override
    here = os.path.join(BIN_DIR, name)
    if os.path.isfile(here) and os.access(here, os.X_OK):
        return here
    found = shutil.which(name)
    if found:
        return found
    for d in (os.path.expanduser("~/.local/bin"), "/usr/local/bin", "/usr/bin"):
        cand = os.path.join(d, name)
        if os.path.isfile(cand) and os.access(cand, os.X_OK):
            return cand
    return name          # let Popen report it in its own words


def log(*a):
    line = f"[{time.strftime('%Y-%m-%d %H:%M:%S')}] " + " ".join(str(x) for x in a)
    with open(LOG, "a") as f:
        f.write(line + "\n")
    print(line, flush=True)


def post_matrix(text):
    text = (text or "").strip()
    if not text:
        text = "(the agent produced no text output)"
    if QUIET:
        log("MATRIX (suppressed):", text[:200].replace("\n", " "))
        return
    try:
        subprocess.run(
            [find_bin("matrix-notify")],
            input=text.encode()[:30000],
            check=True,
            timeout=20,
        )
    except Exception as e:
        log("matrix-notify FAILED:", e)


class Daemon:
    def __init__(self):
        self.proc = None
        self.q = queue.Queue()          # pending FIFO prompts (pid, prompt)
        self.lock = threading.Lock()
        self.busy = False               # a run is active (agent_start..agent_settled)
        self.switching = False           # a session switch is in progress
        self.dispatch_pending = False   # a prompt was sent; awaiting agent_start/rejection
        self.dispatch_deadline = None    # watchdog: when to give up on agent_start
        self.pending_start_source = None  # source of the in-flight new-run dispatch
        self.last_sent_source = None    # source of the most recent prompt sent
        self.current_source = None      # source of the active run (set on agent_start)
        self.current_prompt = None
        self.current_id = None           # caller-provided id, for sync waiters
        self.current_asked = None        # dispatch time, for task logs
        self.cur_text = []              # text deltas of the in-flight message
        self.last_text = None           # final assistant text of current run
        self.last_error = None          # terminal error of the current run (§17)
        self.last_web_message = None    # last web prompt (for steer-turned-run case)
        self.last_web_asked = None
        self.model_input = None         # current model's input types (None = unknown)
        self.usage = None               # §20 usage/balance snapshot for /usage
        self.ui_pending = {}            # §21 extension dialogs awaiting an answer
        self.current_out_dir = None     # §15: this turn's out dir, scanned at settle
        self.req_seq = 0
        self.stdin_lock = threading.Lock()          # serialize writes to pi stdin
        self.pending_requests = {}                  # rid -> (Event, box)
        self.pending_requests_lock = threading.Lock()
        self.cmd_seq = 0                            # command id counter
        self.dispatch_map = {}                      # rid -> {source,pid,prompt}
        self.clients = []                           # SSE client queues
        self.clients_lock = threading.Lock()

    # ---- pi process ----------------------------------------------------
    def record_active_session(self, path):
        """Remember which transcript is live (atomic replace: the daemon may be
        killed at any point, and a half-written record must not become the next
        start's resume target)."""
        try:
            tmp = ACTIVE_FILE + ".tmp"
            with open(tmp, "w") as f:
                f.write(os.path.realpath(path) + "\n")
            os.replace(tmp, ACTIVE_FILE)
        except OSError as e:
            log("could not record the active session file:", e)

    def resume_target(self):
        """Which transcript pi should open at startup, or None to create one.

        `--session-id` alone is not enough: when several files in the session
        dir carry that id, pi resumes the FIRST match by filename — the oldest
        — so every restart silently rewound to the first transcript of that id
        (docs/spec.md §17.5). Resume the recorded active file instead, fall back
        to the most recently written one, and only start a fresh session when
        there is nothing valid to resume.
        """
        roots = [os.path.realpath(SESSIONS_DIR), os.path.realpath(ARCHIVE_DIR)]

        def allowed(p):
            return any(p.startswith(r + os.sep) for r in roots)

        try:
            with open(ACTIVE_FILE, encoding="utf-8") as f:
                rec = f.read().strip()
        except OSError:
            rec = ""
        if rec:
            p = os.path.realpath(rec)
            if allowed(p) and _valid_session_file(p):
                return p
            log("active-session record is unusable, ignoring it:", rec)
        newest = _newest_session_file()
        if newest:
            log("no active-session record; resuming the newest transcript:", newest)
        return newest

    def start_pi(self):
        resume = self.resume_target()
        pi_bin = find_bin("pi", "AGENT_PI_BIN")
        cmd = [
            pi_bin, "--mode", "rpc",
            "--provider", PROVIDER,
            "--model", MODEL,
            "--session-dir", SESSIONS_DIR,
            "-a",  # trust project resources (MCP servers, skills) non-interactively
        ]
        if resume:
            # --session <path> opens exactly this file; --session-id would pick
            # an arbitrary namesake (the oldest). No -n either: a name flag is
            # written into the transcript as a session_info and would rename the
            # resumed session (verified), so the file's own name wins.
            cmd += ["--session", resume]
        else:
            cmd += ["--session-id", SESSION_ID, "-n", SESSION_NAME]
        log("starting pi:", " ".join(cmd), "cwd=", WORKDIR)
        # A mount that is not up yet (or a package being upgraded under us) used
        # to take the whole service down at boot. Retry briefly before giving
        # up: main() exits 1, so systemd will restart us either way.
        for attempt in range(1, 6):
            try:
                self.proc = subprocess.Popen(
                    cmd,
                    cwd=WORKDIR,
                    stdin=subprocess.PIPE,
                    stdout=subprocess.PIPE,
                    stderr=subprocess.PIPE,
                    bufsize=1,
                    text=True,
                )
                break
            except FileNotFoundError as e:
                if attempt >= 5:
                    raise
                log(f"pi not runnable yet ({e}); retrying in 2s")
                time.sleep(2)
        threading.Thread(target=self._drain_stderr, daemon=True).start()

    def _track_active_session(self):
        """Ask pi which file it really opened and remember it, so the next start
        resumes that transcript. pi answers get_state only once it is up, and
        read_events() is already draining stdout by then."""
        for _ in range(30):
            try:
                st = self.send_cmd_with_response({"type": "get_state"}, timeout=10)
            except TimeoutError:
                time.sleep(1)
                continue
            f = (st.get("data") or {}).get("sessionFile")
            if f and _valid_session_file(f):
                self.record_active_session(f)
                log("active session recorded:", f)
                return
            if not f:
                return          # pi has no session (--no-session): nothing to record
            time.sleep(1)       # a session pi just created may not be flushed yet
        log("could not record the active session file at startup")

    def _drain_stderr(self):
        for line in self.proc.stderr:
            log("pi.stderr:", line.rstrip())

    def send_cmd(self, obj):
        with self.stdin_lock:
            self.proc.stdin.write(json.dumps(obj) + "\n")
            self.proc.stdin.flush()

    # ---- dispatch ------------------------------------------------------
    def maybe_dispatch(self):
        """Send the next queued FIFO prompt if no run is active or pending."""
        with self.lock:
            if self.dispatch_pending and self.dispatch_deadline \
                    and time.time() > self.dispatch_deadline:
                log("dispatch watchdog: no agent_start in", DISPATCH_TIMEOUT,
                    "s; clearing stuck pending dispatch")
                self.dispatch_pending = False
                self.pending_start_source = None
                self.dispatch_deadline = None
            if self.busy or self.dispatch_pending or self.switching:
                return
            try:
                pid, prompt, attempts = self.q.get_nowait()
            except queue.Empty:
                return
            source = "siri" if pid else "matrix"
            self.dispatch_pending = True
            self.dispatch_deadline = time.time() + DISPATCH_TIMEOUT
            self.pending_start_source = source
            self.last_sent_source = source
            self.current_prompt = prompt
            self.current_id = pid
            self.current_asked = time.time()
            self.cur_text = []
            self.last_text = None
            self.last_error = None
            self.req_seq += 1
            rid = f"fifo-{self.req_seq}"
            self.dispatch_map[rid] = {"source": source, "pid": pid, "prompt": prompt,
                                      "attempts": attempts}
        log("PROMPT ->", prompt, "id=", pid)
        # Voice hint only for Siri-originated prompts (those arrive with a caller
        # id); Matrix-originated prompts get natural, unhinted answers.
        hint = VOICE_HINT if pid else ""
        self.send_cmd({"id": rid, "type": "prompt", "message": prompt + hint})

    def web_prompt(self, message, images=None):
        """Web sends a message. Always prompt + streamingBehavior:steer; pi
        decides atomically whether it starts a run or steers the current one.

        With images, the run must be on a vision model: auto-switch when a new
        run is starting, and refuse to steer an image into a busy text-only run
        (a steer cannot change the model of a run already in flight).

        Images are also materialized to disk (§15) so the agent's tools —
        ffmpeg, not the vision model — can edit them; the prompt carries the
        on-disk paths and a per-turn output directory.
        """
        images = images or []
        if self.switching:
            return {"error": "a session switch is in progress — try again in a moment"}
        if images and not self._model_accepts_images():
            with self.lock:
                busy = self.busy or self.dispatch_pending
            if busy:
                return {"error": "the current model can't see pictures and a run "
                                 "is in progress — stop it first, or switch to a "
                                 "vision model"}
            try:
                self.model_set(VISION_PROVIDER, VISION_MODEL_ID)
            except Exception as e:
                log("auto-switch to vision model failed:", e)
                return {"error": f"couldn't switch to vision model "
                                 f"{VISION_MODEL_ID}: {e}"}
        # §15: the turn id is assigned up front so the on-disk attachment names
        # and the dispatch share it even though the save below is I/O.
        with self.lock:
            self.req_seq += 1
            seq = self.req_seq
        rid = f"web-{seq}"
        in_paths, out_dir = [], None
        if images:
            with self.lock:
                out_dir = self.current_out_dir or os.path.join(ATTACH_DIR, "out", rid)
            in_paths = self._save_images(rid, images)
            os.makedirs(out_dir, exist_ok=True)
            full_message = message + self._attachment_hint(in_paths, out_dir)
        else:
            full_message = message
        with self.lock:
            starting = not self.busy and not self.dispatch_pending
            self.last_sent_source = "web"
            self.last_web_message = message
            self.last_web_asked = time.time()
            if starting:
                self.dispatch_pending = True
                self.dispatch_deadline = time.time() + DISPATCH_TIMEOUT
                self.pending_start_source = "web"
                self.current_prompt = message
                self.current_id = None
                self.current_asked = time.time()
                self.cur_text = []
                self.last_text = None
                self.last_error = None
                self.dispatch_map[rid] = {"source": "web", "pid": None,
                                          "prompt": message, "attempts": 0}
                if images:
                    self.current_out_dir = out_dir
        log("WEB PROMPT ->", message,
            "steer" if not starting else "new",
            f"images={len(images)}" if images else "")
        cmd = {"id": rid, "type": "prompt", "message": full_message,
               "streamingBehavior": "steer"}
        if images:
            cmd["images"] = images
        self.send_cmd(cmd)
        return {"status": "steered" if not starting else "accepted"}

    def _save_images(self, rid, images):
        """Materialize incoming base64 images to disk so the agent's tools
        (ffmpeg, not the vision model) can edit them. Returns absolute paths."""
        paths = []
        for i, im in enumerate(images, 1):
            ext = IMG_EXT.get(im.get("mimeType", ""), ".bin")
            p = os.path.join(ATTACH_DIR, "in", f"{rid}-{i}{ext}")
            try:
                with open(p, "wb") as f:
                    f.write(base64.b64decode(im["data"]))
                paths.append(p)
            except Exception as e:
                log("failed to save attachment:", e)
        return paths

    def _attachment_hint(self, in_paths, out_dir):
        return (HINT_MARK + ", ".join(in_paths) +
                " — edit them with ffmpeg as the user asks. Save any output image "
                "to " + out_dir + "/ with a descriptive filename; it is shown to "
                "the user automatically.]")

    def _collect_attachments(self, out_dir):
        """List image files the agent produced in this turn's out dir (§15).
        Images only for v1 (review #4); an empty or missing dir simply yields
        no event."""
        if not out_dir or not os.path.isdir(out_dir):
            return []
        base = os.path.basename(out_dir.rstrip("/"))
        files = []
        for name in sorted(os.listdir(out_dir)):
            if os.path.splitext(name)[1].lower() not in IMG_EXTS:
                continue
            url = ("/media/out/" + urllib.parse.quote(base) + "/"
                   + urllib.parse.quote(name))
            files.append({"name": name, "url": url})
        return files

    def send_cmd_with_response(self, obj, timeout=15):
        """Send a command and wait for its `response` event (get_state etc.)."""
        with self.pending_requests_lock:
            rid = f"cmd-{self.cmd_seq}"
            self.cmd_seq += 1
            evt = threading.Event()
            box = {}
            self.pending_requests[rid] = (evt, box)
        self.send_cmd({**obj, "id": rid})
        if not evt.wait(timeout):
            with self.pending_requests_lock:
                self.pending_requests.pop(rid, None)
            raise TimeoutError(f"{obj.get('type')} timed out")
        return box.get("resp")

    def _refresh_model_input(self):
        """Fetch the current model's input capability from get_state."""
        try:
            st = self.send_cmd_with_response({"type": "get_state"}, timeout=10)
            m = (st.get("data") or {}).get("model") or {}
            self.model_input = m.get("input") or []
            log("current model input:", self.model_input)
        except Exception as e:
            log("refresh model input failed:", e)
            self.model_input = None   # unknown again; retry next time

    def _model_accepts_images(self):
        if self.model_input is None:
            self._refresh_model_input()
        return "image" in (self.model_input or [])

    # ---- session switching --------------------------------------------
    def craft_session_file(self):
        """Write a fresh header-only session file, byte-identical to the first
        line pi itself writes. RPC new_session would mint a random session id
        and break the daemon's --session-id resume-on-restart, so a new
        session means switch_session onto one of these (id stays SESSION_ID)."""
        dt = datetime.now(timezone.utc)
        iso = dt.strftime("%Y-%m-%dT%H:%M:%S.") + f"{dt.microsecond // 1000:03d}Z"
        fname = iso.replace(":", "-").replace(".", "-") + f"_{SESSION_ID}.jsonl"
        path = os.path.join(SESSIONS_DIR, fname)
        header = {"type": "session", "version": 3, "id": SESSION_ID,
                  "timestamp": iso, "cwd": WORKDIR}
        with open(path, "w", encoding="utf-8") as f:
            f.write(json.dumps(header) + "\n")
        return path

    def _abort_and_settle(self, timeout=8):
        """Stop any in-flight run (clear_queue + abort, the Esc path) and wait
        for agent_settled so the switch lands on an idle session."""
        with self.lock:
            active = self.busy or self.dispatch_pending
        if not active:
            return
        self.send_cmd({"type": "clear_queue"})
        self.send_cmd({"type": "abort"})
        deadline = time.time() + timeout
        while time.time() < deadline:
            with self.lock:
                if not self.busy and not self.dispatch_pending:
                    return
            time.sleep(0.1)
        log("switch: run did not settle after abort; forcing state reset")

    def _reset_run_state(self):
        with self.lock:
            self.busy = False
            self.dispatch_pending = False
            self.dispatch_deadline = None
            self.pending_start_source = None
            self.current_source = None
            self.current_prompt = None
            self.current_id = None
            self.current_asked = None
            self.cur_text = []
            self.last_text = None
            self.last_error = None
            self.current_out_dir = None
            self.dispatch_map.clear()
            # §2.4/B1: a switch silently puts pi back on the daemon's --model,
            # whatever the user picked and whatever the vision auto-switch set.
            # Dropping the cached capability makes the next image prompt
            # re-query it instead of trusting a model we are no longer on.
            self.model_input = None

    def switch_to_new(self, archive, name=None):
        """Switch pi onto a fresh session (see craft_session_file). The old
        transcript is left in sessions/ (listed as a previous session) or
        moved to ARCHIVE_DIR. Auto-aborts any in-flight run first.
        `name` optionally names the new session (default: SESSION_NAME)."""
        with self.lock:
            if self.switching:
                return {"error": "a session switch is already in progress"}
            self.switching = True
        try:
            return self._switch_to_new(archive, name)
        finally:
            with self.lock:
                self.switching = False
            self.maybe_dispatch()   # queued prompts continue in the new session

    def _switch_to_new(self, archive, name=None):
        self._abort_and_settle()
        self._reset_run_state()
        try:
            st = self.send_cmd_with_response({"type": "get_state"}, timeout=10)
        except TimeoutError as e:
            return {"error": f"get_state before switch timed out: {e}"}
        data = st.get("data") or {}
        old_file = data.get("sessionFile")
        if not old_file or not os.path.isfile(old_file):
            return {"error": "could not determine the current session file"}
        if archive and not data.get("messageCount"):
            return {"error": "the current session is empty — nothing to archive"}
        new_file = self.craft_session_file()
        try:
            resp = self.send_cmd_with_response(
                {"type": "switch_session", "sessionPath": new_file}, timeout=30)
        except TimeoutError:
            # The response may be lost while the switch still landed; ask pi
            # what session it is on now instead of guessing.
            try:
                st2 = self.send_cmd_with_response({"type": "get_state"}, timeout=10)
                if (st2.get("data") or {}).get("sessionFile") != new_file:
                    raise TimeoutError("switch_session never landed")
                resp = {"success": True, "data": {}}
            except TimeoutError as e:
                return {"error": f"switch_session failed: {e} "
                                 f"(the crafted file was left on disk)"}
        rdata = resp.get("data") or {}
        if resp.get("success") is False or rdata.get("cancelled"):
            try:
                os.remove(new_file)
            except OSError:
                pass
            why = ("cancelled by an extension" if rdata.get("cancelled")
                   else (resp.get("error") or "pi refused the switch"))
            return {"error": f"switch failed: {why}"}
        # A header-only file has no session_info entry; re-apply the display
        # name so it survives restarts and shows in listings.
        try:
            self.send_cmd_with_response(
                {"type": "set_session_name", "name": (name or SESSION_NAME).strip()[:80]},
                timeout=10)
        except TimeoutError:
            log("set_session_name after switch timed out (non-fatal)")
        moved = None
        if archive:
            try:
                os.makedirs(ARCHIVE_DIR, exist_ok=True)
                dest = os.path.join(ARCHIVE_DIR, os.path.basename(old_file))
                os.replace(old_file, dest)
                moved = dest
            except OSError as e:
                log("archive move failed:", e)
                return {"error": f"session switched, but the archive move "
                                 f"failed: {e}"}
        log("SESSION SWITCHED:", "archive" if archive else "new",
            "old=", old_file, "new=", new_file)
        self.record_active_session(new_file)
        self.broadcast({"type": "session_switched",
                        "archived": bool(moved), "newFile": new_file})
        return {"ok": True, "oldFile": old_file, "newFile": new_file,
                "archived": moved}

    def open_session(self, path, unarchive=False):
        """Switch pi onto an EXISTING transcript (resume it in place, keeping
        its messages and its name). The caller has already validated the path
        and confined it to sessions/ or archive/.

        `unarchive` means it came from archive/: resuming it moves it back to
        sessions/ first, so it returns as a normal live session and can be
        archived again later (B5).

        Why this exists: `switch_to_new` can only start a *fresh* session, and
        `--session-id` resume after a daemon restart picks the OLDEST file with
        that id when several exist (docs/spec.md §17.5), so the only way back
        to a specific transcript — including the one that was live before a
        restart — is an explicit switch.
        """
        with self.lock:
            if self.switching:
                return {"error": "a session switch is already in progress"}
            self.switching = True
        try:
            return self._open_session(path, unarchive=unarchive)
        finally:
            with self.lock:
                self.switching = False
            self.maybe_dispatch()   # queued prompts continue in the opened session

    def _open_session(self, path, unarchive=False):
        # --- B3: everything checkable comes BEFORE the abort. Opening the
        # session that is already live used to kill its running reply and only
        # then report that there was nothing to do.
        try:
            st = self.send_cmd_with_response({"type": "get_state"}, timeout=10)
        except TimeoutError as e:
            return {"error": f"get_state before switch timed out: {e}"}
        old_file = (st.get("data") or {}).get("sessionFile")
        if old_file and os.path.realpath(old_file) == os.path.realpath(path):
            return {"error": "that session is already open"}
        dest = None
        if unarchive:
            dest = os.path.join(SESSIONS_DIR, os.path.basename(path))
            if os.path.exists(dest):
                return {"error": "a session with that file name already exists "
                                 "in sessions/", "status": 409}

        self._abort_and_settle()
        # --- B8: a run that did not settle cannot be delivered by settle(), and
        # the reset below is about to forget who was waiting for it.
        stale = self._interrupted_caller()
        self._reset_run_state()
        if stale:
            self._notify_interrupted(stale)

        prev = None
        if unarchive:
            try:
                os.replace(path, dest)
            except OSError as e:
                return {"error": f"could not un-archive the session: {e}"}
            log("SESSION UN-ARCHIVED:", path, "->", dest)
            path, prev = dest, path

        def rollback():
            """A failed switch must leave the transcript where it was found.
            The file is never deleted; if the move back fails it stays in
            sessions/ and the log says so."""
            if not prev:
                return
            try:
                os.replace(path, prev)
                log("SESSION SWITCH ROLLED BACK:", path, "->", prev)
            except OSError as e:
                log("rollback failed; the transcript is safe in sessions/:", e)

        try:
            resp = self.send_cmd_with_response(
                {"type": "switch_session", "sessionPath": path}, timeout=30)
        except TimeoutError:
            # The response may be lost while the switch still landed; ask pi
            # what session it is on now instead of guessing (see _switch_to_new).
            try:
                st2 = self.send_cmd_with_response({"type": "get_state"}, timeout=10)
                landed = (st2.get("data") or {}).get("sessionFile")
                if not landed or os.path.realpath(landed) != os.path.realpath(path):
                    raise TimeoutError("switch_session never landed")
                resp = {"success": True, "data": {}}
            except TimeoutError as e:
                rollback()
                return {"error": f"switch_session failed: {e}"}
        rdata = resp.get("data") or {}
        if resp.get("success") is False or rdata.get("cancelled"):
            rollback()
            why = ("cancelled by an extension" if rdata.get("cancelled")
                   else (resp.get("error") or "pi refused the switch"))
            return {"error": f"switch failed: {why}"}
        # The opened file carries its own session_info name; read it back so the
        # caller can report what the dashboard header will show.
        name = None
        try:
            st3 = self.send_cmd_with_response({"type": "get_state"}, timeout=10)
            name = (st3.get("data") or {}).get("sessionName")
        except TimeoutError:
            pass
        log("SESSION OPENED: old=", old_file, "new=", path, "name=", name,
            *("unarchived=yes",) if prev else ())
        self.record_active_session(path)
        self.broadcast({"type": "session_switched", "archived": False,
                        "newFile": path, "unarchived": bool(prev)})
        return {"ok": True, "oldFile": old_file, "newFile": path, "name": name,
                "unarchived": bool(prev)}

    def delete_session(self, path, which):
        """Soft-delete a transcript: move it to TRASH_DIR (Part C).

        Takes the same guard as a session switch, so a delete cannot race an
        /opensession of the same file (or its un-archive move). The live session
        is refused — the caller has to switch away first.
        """
        with self.lock:
            if self.switching:
                return {"error": "a session switch is in progress — "
                                 "try again in a moment", "status": 409}
            self.switching = True
        try:
            return self._delete_session(path, which)
        finally:
            with self.lock:
                self.switching = False
            self.maybe_dispatch()

    def _delete_session(self, path, which):
        # The live session is not deletable. Check pi AND the record: right
        # after a restart they can disagree, and either one being this file
        # means deleting it would pull the floor out from under the daemon.
        try:
            st = self.send_cmd_with_response({"type": "get_state"}, timeout=10)
        except TimeoutError as e:
            return {"error": f"get_state before delete timed out: {e}"}
        live = (st.get("data") or {}).get("sessionFile")
        try:
            with open(ACTIVE_FILE, encoding="utf-8") as f:
                rec = f.read().strip()
        except OSError:
            rec = ""
        for candidate, why in ((live, "pi is on it"), (rec, "it is the recorded active session")):
            if candidate and os.path.realpath(candidate) == os.path.realpath(path):
                log("refusing to delete the live session:", path, "(", why, ")")
                return {"error": "that is the live session — switch to "
                                 "another one first", "status": 409}

        base = os.path.basename(path)
        stamp = int(time.time())
        stem = base[:-len(".jsonl")] if base.endswith(".jsonl") else base
        dest = os.path.join(TRASH_DIR, f"{stem}-{stamp}.jsonl")
        n = 1
        while os.path.exists(dest):     # two deletes in the same second
            dest = os.path.join(TRASH_DIR, f"{stem}-{stamp}-{n}.jsonl")
            n += 1
        try:
            os.makedirs(TRASH_DIR, exist_ok=True)
            os.replace(path, dest)
        except OSError as e:
            return {"error": f"could not move the session to the trash: {e}"}
        log("SESSION DELETED:", path, "->", dest)
        self.broadcast({"type": "session_deleted", "file": base, "dir": which})
        return {"ok": True, "trashed": dest}

    def _interrupted_caller(self):
        """Who is waiting on the run a switch is about to discard, if anyone.

        Read BEFORE _reset_run_state(): if settle() already ran, the fields are
        empty and there is nothing to deliver — so this can never double-send.
        """
        with self.lock:
            if not self.current_source:
                return None
            return {"source": self.current_source, "pid": self.current_id,
                    "prompt": self.current_prompt}

    def _notify_interrupted(self, who):
        """Tell a Siri/Matrix caller their run was cut short by a switch. The
        dashboard sees the switch itself over SSE."""
        msg = "⚠ Interrupted: the session was switched from the web dashboard."
        log("interrupted run, notifying:", who.get("source"), who.get("pid"))
        if who.get("source") == "siri" and who.get("pid"):
            rpath = os.path.join(STATE, "results", f"{who['pid']}.result")
            os.makedirs(os.path.dirname(rpath), exist_ok=True)
            with open(rpath, "w") as f:
                f.write(msg)
        elif who.get("source") == "matrix":
            threading.Thread(
                target=post_matrix,
                args=(f"\U0001f916 {who.get('prompt') or ''}\n\n{msg}",),
                daemon=True).start()

    def model_set(self, provider, model_id):
        """Switch model and refresh the cached input capability."""
        resp = self.send_cmd_with_response({
            "type": "set_model", "provider": provider, "modelId": model_id,
        })
        self._refresh_model_input()
        return resp

    def on_prompt_rejected(self, rid, err=None):
        """pi rejected a prompt we thought would start a run.

        Retries with backoff on a worker thread (never on the event loop) and
        gives up after MAX_PROMPT_ATTEMPTS, telling whoever asked. A permanent
        rejection — a model switched to a provider with no credentials, say —
        would otherwise re-dispatch forever.
        """
        with self.lock:
            info = self.dispatch_map.pop(rid, None)
            self.dispatch_pending = False
            self.pending_start_source = None
            self.dispatch_deadline = None
            if info is None:
                return
            if not self.busy:
                self.current_prompt = None
                self.current_id = None
                self.current_asked = None
                self.cur_text = []
                self.last_error = None
            attempts = (info.get("attempts") or 0) + 1
        log("prompt rejected by pi:", err, "| attempt", attempts,
            "| prompt:", info.get("prompt"))
        if info["source"] == "web":
            return      # the browser saw the failed response over SSE
        if attempts >= MAX_PROMPT_ATTEMPTS:
            msg = (f"The agent refused this prompt after {attempts} attempts: "
                   f"{err or 'unknown error'}")
            log("giving up on prompt after", attempts, "attempts")
            if info["source"] == "siri" and info["pid"]:
                rpath = os.path.join(STATE, "results", f"{info['pid']}.result")
                os.makedirs(os.path.dirname(rpath), exist_ok=True)
                with open(rpath, "w") as f:
                    f.write(msg)
            else:
                threading.Thread(target=post_matrix,
                                 args=(f"\U0001f916 {info['prompt']}\n\n{msg}",),
                                 daemon=True).start()
            self.maybe_dispatch()
            return

        def _retry():
            time.sleep(min(9, 3 ** (attempts - 1)))
            self.q.put((info["pid"], info["prompt"], attempts))
            self.maybe_dispatch()

        threading.Thread(target=_retry, daemon=True).start()

    def settle(self):
        with self.lock:
            source = self.current_source
            prompt = self.current_prompt
            pid = self.current_id
            answer = self.last_text
            error = self.last_error
            asked = self.current_asked or time.time()
            out_dir = self.current_out_dir
            self.current_out_dir = None
            self.last_error = None
            self.busy = False
            self.dispatch_pending = False
            self.dispatch_deadline = None
            self.pending_start_source = None
            self.current_source = None
            self.current_prompt = None
            self.current_id = None
            self.current_asked = None
        now = time.time()
        answer_1line = (answer or "").replace("\n", " ")
        log("SETTLED. prompt=", prompt, "source=", source,
            "dur_s=", round(now - asked, 1),
            "answer_len=", len(answer or ""),
            *(('error=' + error.replace("\n", " ")[:400],) if error else ()),
            "answer=", answer_1line[:400])
        delivered = {"siri": "spoken", "matrix": "matrix", "web": "web"}.get(source, "unknown")
        # §17: an errored run must never be delivered as a silent empty answer.
        # Siri/Matrix get an explicit failure line; the web dashboard renders
        # the error from the message_end event (and from the snapshot) itself.
        spoken = answer or (f"⚠ The agent failed: {error}" if error else "")
        task_path = self.write_task_log(pid, prompt, answer, asked, now, delivered,
                                        status="error" if error else "ok", error=error)
        if source == "siri" and pid:
            # Synchronous caller is polling for this file. If they consume it
            # (delete) before GRACE elapses, no Matrix message is sent — the
            # answer was already spoken. Otherwise fall back to Matrix.
            rpath = os.path.join(STATE, "results", f"{pid}.result")
            os.makedirs(os.path.dirname(rpath), exist_ok=True)
            with open(rpath, "w") as f:
                f.write(spoken or "")

            def _grace():
                time.sleep(GRACE)
                if os.path.exists(rpath):
                    try:
                        os.remove(rpath)
                    except OSError:
                        pass
                    msg = f"🤖 {prompt}\n\n{spoken}" if prompt else (spoken or "")
                    post_matrix(msg)
                    with open(task_path, "a") as f:
                        f.write(f"note: caller did not pick up within window; "
                                f"delivered via Matrix at "
                                f"{time.strftime('%Y-%m-%dT%H:%M:%S%z')}\n")

            threading.Thread(target=_grace, daemon=True).start()
        elif source == "matrix":
            msg = f"🤖 {prompt}\n\n{spoken}" if prompt else (spoken or "")
            threading.Thread(target=post_matrix, args=(msg,), daemon=True).start()
        elif source == "web":
            # §15: any image files the agent produced this turn go back to the
            # dashboard. Empty/missing dir or non-images → no event (review #4).
            files = self._collect_attachments(out_dir)
            if files:
                self.broadcast({"type": "web_attachments", "files": files})
        self.maybe_dispatch()

    def write_task_log(self, pid, prompt, answer, asked, settled_ts, delivered,
                       status="ok", error=None):
        os.makedirs(TASKS, exist_ok=True)
        if pid:
            path = os.path.join(TASKS, f"{pid}.log")
        else:
            stamp = time.strftime("%Y%m%d-%H%M%S")
            path = os.path.join(TASKS, f"plain-{stamp}-{self.req_seq}.log")
        with open(path, "w") as f:
            f.write(f"prompt: {prompt}\n")
            f.write(f"asked: {time.strftime('%Y-%m-%dT%H:%M:%S%z', time.localtime(asked))}\n")
            f.write(f"settled: {time.strftime('%Y-%m-%dT%H:%M:%S%z', time.localtime(settled_ts))}\n")
            f.write(f"duration_s: {round(settled_ts - asked, 1)}\n")
            f.write(f"status: {status}\n")
            if error:
                f.write(f"error: {' '.join(error.split())}\n")
            f.write(f"delivered: {delivered}\n")
            f.write("answer:\n")
            if answer:
                f.write(answer.rstrip() + "\n")
            else:
                f.write("(no text)\n")
        return path

    # ---- event loop ----------------------------------------------------
    def broadcast(self, obj):
        line = json.dumps(obj)
        with self.clients_lock:
            clients = list(self.clients)
        for q in clients:
            try:
                q.put_nowait(line)   # drop-slowest; never block the event loop
            except queue.Full:
                pass

    def _clean_for_clients(self, ev):
        """Strip the §15 attachment hint from user messages before they reach
        SSE clients: the page dedups its own prompts via mine[], and the hint
        would make the echoed text differ from what the user typed."""
        m = ev.get("message") if isinstance(ev.get("message"), dict) else None
        if ev.get("type") in ("message_start", "message_end") and m \
                and m.get("role") == "user":
            content = m.get("content")
            if isinstance(content, list):
                newc, changed = [], False
                for c in content:
                    if isinstance(c, dict) and c.get("type") == "text" \
                            and HINT_MARK in (c.get("text") or ""):
                        newc.append({**c,
                                     "text": c["text"].split(HINT_MARK)[0].rstrip()})
                        changed = True
                    elif isinstance(c, dict) and c.get("type") == "image" \
                            and c.get("data"):
                        # a chat photo is hundreds of KB of base64; the page that
                        # sent it already rendered it, and reconnects re-fetch the
                        # full snapshot — don't re-push it to every client
                        newc.append({**c, "data": ""})
                        changed = True
                    else:
                        newc.append(c)
                if changed:
                    return {**ev, "message": {**m, "content": newc}}
        return ev

    def read_events(self):
        for line in self.proc.stdout:
            line = line.strip()
            if not line:
                continue
            try:
                ev = json.loads(line)
            except json.JSONDecodeError:
                continue
            t = ev.get("type")
            # cmd-* responses carry whole transcripts (a get_messages reply is
            # ~170 KB); their HTTP caller is already correlated by id, so they
            # must not also be pushed down every SSE stream. web-*/fifo-*
            # prompt responses are small and let the UI report a rejection.
            if not (t == "response" and str(ev.get("id") or "").startswith("cmd-")):
                self.broadcast(self._clean_for_clients(ev))
            if t == "message_start":
                self.cur_text = []
            elif t == "message_update":
                ame = ev.get("assistantMessageEvent") or {}
                if ame.get("type") == "text_delta":
                    self.cur_text.append(ame.get("delta", ""))
            elif t == "message_end":
                m = ev.get("message") if isinstance(ev.get("message"), dict) else {}
                buf = "".join(self.cur_text).strip()
                if buf:
                    self.last_text = buf
                self.cur_text = []
                # §17: a failed assistant message ends with stopReason "error"
                # (a provider error, or a pi whose bundle chunks were replaced by
                # an in-place upgrade under the running process). That is a
                # terminal failure, not an empty answer: record it so settle()
                # can say so instead of reporting success with answer_len=0.
                if m.get("role") == "assistant":
                    if m.get("stopReason") == "error":
                        err = (m.get("errorMessage") or "").strip() \
                              or "the model returned an error"
                        with self.lock:
                            self.last_error = err
                        log("RUN ERROR:", err.replace("\n", " "))
                    elif m.get("stopReason") in ("stop", "toolUse", "length"):
                        # pi retries provider errors automatically (auto_retry_*);
                        # a later successful response means the run recovered, so
                        # the earlier failure is no longer this run's outcome.
                        with self.lock:
                            self.last_error = None
            elif t == "agent_start":
                # pi emits agent_start for EVERY low-level run, so one prompt
                # produces several: one per auto-retry, one per compaction
                # continuation, one per queued-message continuation (see
                # pi-agent-core agent-loop.js:runAgentLoopContinue, driven by
                # agent-session.js:_runAgentPrompt). Only the FIRST one decides
                # who owns the run. A later one must never re-attribute it or
                # wipe the answer accumulated so far, or a Siri/Matrix answer
                # is silently lost to the "web" branch in settle().
                with self.lock:
                    self.busy = True
                    self.dispatch_pending = False
                    self.dispatch_deadline = None
                    if self.pending_start_source:
                        self.current_source = self.pending_start_source
                        self.pending_start_source = None
                        self.dispatch_map.clear()
                    elif self.current_source is None:
                        # A run we never dispatched: a web prompt that landed in
                        # the settle gap, where pi was already idle internally
                        # and so treated the steer as a fresh prompt.
                        self.current_source = "web"
                        self.current_prompt = self.last_web_message
                        self.current_id = None
                        self.current_asked = self.last_web_asked or time.time()
                        self.cur_text = []
                        self.last_text = None
                        self.last_error = None
                    # else: a continuation of the run already in flight. Keep
                    # source, prompt, caller id and accumulated text untouched.
            elif t == "agent_settled":
                # Any dialog still open belongs to the run that just ended.
                self.cancel_pending_ui("the run ended")
                if self.busy:
                    self.settle()
                else:
                    # A run we never attributed (an aborted dispatch, or an
                    # extension command) must not leave the FIFO guard set.
                    with self.lock:
                        self.dispatch_pending = False
                        self.pending_start_source = None
                        self.dispatch_deadline = None
                    self.maybe_dispatch()
            elif t == "response":
                rid = ev.get("id")
                with self.pending_requests_lock:
                    p = self.pending_requests.pop(rid, None)
                if p:
                    evt, box = p
                    box["resp"] = ev
                    evt.set()
                if ev.get("command") == "prompt" and ev.get("success") is False:
                    self.on_prompt_rejected(rid, ev.get("error"))
            elif t == "extension_ui_request":
                self.on_ui_request(ev)
            elif t == "auto_retry_start":
                log("pi auto-retry", ev.get("attempt"), "of", ev.get("maxAttempts"),
                    "in", ev.get("delayMs"), "ms:", ev.get("errorMessage"))
            elif t == "error":
                log("pi error event:", ev.get("error"))
        log("pi stdout closed; exiting event loop")

    # ---- FIFO reader ---------------------------------------------------
    def read_fifo(self):
        if not os.path.exists(FIFO):
            os.mkfifo(FIFO)
        log("listening on FIFO:", FIFO)
        while True:
            with open(FIFO, "r") as f:      # blocks until a writer connects
                for line in f:
                    line = line.strip()
                    if not line:
                        continue
                    pid, prompt = None, line
                    if line.startswith("{"):
                        try:
                            obj = json.loads(line)
                            pid = obj.get("id")
                            if obj.get("prompt_b64"):
                                prompt = base64.b64decode(obj["prompt_b64"]).decode("utf-8", "replace")
                            elif obj.get("prompt"):
                                prompt = obj["prompt"]
                        except Exception:
                            pass
                    log("QUEUED <-", prompt, "id=", pid)
                    self.q.put((pid, prompt, 0))
                    self.maybe_dispatch()

    def start_web(self):
        if not WEB_ENABLED:
            return
        Handler.d = self
        try:
            srv = ThreadingHTTPServer((WEB_HOST, WEB_PORT), Handler)
        except Exception as e:
            log("web server FAILED to bind:", e)
            return
        srv.daemon_threads = True
        threading.Thread(target=srv.serve_forever, daemon=True).start()
        log("web dashboard on http://%s:%d" % (WEB_HOST, WEB_PORT))

    def janitor(self):
        """Periodically re-check dispatch, so a stuck pending guard heals on
        its own instead of waiting for the next FIFO prompt. Also ages out the
        trash: soft delete is only a safety net if something eventually empties
        it (Part C)."""
        while True:
            time.sleep(JANITOR_INTERVAL)
            try:
                self.maybe_dispatch()
            except Exception as e:
                log("janitor error:", e)
            try:
                self.purge_trash()
            except Exception as e:
                log("trash purge error:", e)

    # ---- usage (transcript totals + an optional account balance) ------
    def _day_start(self):
        """Local midnight, as epoch seconds — the boundary for "today"."""
        lt = time.localtime()
        return time.mktime((lt.tm_year, lt.tm_mon, lt.tm_mday,
                            0, 0, 0, 0, 0, -1))

    def usage_cmd(self, provider):
        """The command that reports `provider`'s account balance, if any.

        Provider-agnostic by configuration: AGENT_USAGE_CMD wins, else an
        installed `agent-usage-<provider>` or `<provider>-usage`. No command
        means no balance — the transcript totals stand on their own and nothing
        is invented for a provider that cannot be asked.
        """
        if USAGE_CMD:
            return USAGE_CMD.split()
        for name in (f"agent-usage-{provider}", f"{provider}-usage"):
            hit = find_bin(name)
            if os.path.isfile(hit) and os.access(hit, os.X_OK):
                return [hit]
        return None

    def read_balance(self, provider):
        """Run the provider's balance helper. Returns None when there is none,
        else a dict with ok=False and a reason rather than a wrong number."""
        cmd = self.usage_cmd(provider)
        if not cmd:
            return None
        out = {"cmd": " ".join(cmd), "provider": provider,
               "fetched": time.time()}
        try:
            r = subprocess.run(cmd, capture_output=True, text=True, timeout=40)
            raw = json.loads(r.stdout)
        except Exception as e:
            return {**out, "ok": False, "err": str(e)[:80]}
        if not isinstance(raw, dict) or "error" in raw:
            err = raw.get("error") if isinstance(raw, dict) else "unexpected output"
            return {**out, "ok": False, "err": str(err)[:80]}
        return {**raw, **out, "ok": True}

    def usage_loop(self):
        """Keep the /usage snapshot current.

        The transcript totals are local and cheap; the balance is a network call
        to one provider, so it is re-read on USAGE_INTERVAL — and immediately
        when the provider changes, because another provider's balance is not a
        stale number, it is the wrong one.
        """
        balance, balance_provider, next_balance = None, None, 0.0
        while True:
            provider, model_id, path = "", "", None
            try:
                st = self.send_cmd_with_response({"type": "get_state"}, timeout=10)
                d = st.get("data") or {}
                model_id = (d.get("model") or {}).get("id") or ""
                provider = (d.get("model") or {}).get("provider") or ""
                path = d.get("sessionFile")
            except TimeoutError:
                pass
            if provider != balance_provider:
                balance, balance_provider, next_balance = None, provider, 0.0
            if time.time() >= next_balance:
                next_balance = time.time() + USAGE_INTERVAL
                got = self.read_balance(provider)
                if got is not None:
                    balance = got
                else:
                    balance = None      # nothing to ask for this provider
            snap = {"provider": provider, "model": model_id, "file": path,
                    "fetched": time.time()}
            if balance:
                snap["balance"] = balance
            if path and os.path.isfile(path):
                totals = transcript_usage(path, day_start=self._day_start())
                if totals:
                    snap.update(totals)
            with self.lock:
                self.usage = snap
            time.sleep(USAGE_REFRESH)

    # ---- extension dialogs (§21) ---------------------------------------
    def on_ui_request(self, ev):
        """An extension wants an answer from a human.

        pi only emits these for methods that carry a decision; notify/setTitle/
        setStatus need no reply and are just logged. Relaying rather than
        auto-cancelling is the whole point: the approval gate asks through
        here, and until now every question was answered 'cancelled' the
        instant it was asked, so a mutating tool call was refused without the
        user ever seeing it.
        """
        method = ev.get("method")
        if method not in ("select", "confirm", "input", "editor"):
            log("extension UI:", method, ev.get("title") or ev.get("message") or "")
            return
        rid = ev.get("id")
        req = {"type": "ui_request", "id": rid, "method": method,
               "title": ev.get("title") or "", "asked": time.time(),
               "deadline": time.time() + UI_TIMEOUT}
        for key in ("message", "options", "placeholder", "prefill"):
            if ev.get(key) is not None:
                req[key] = ev[key]
        with self.lock:
            self.ui_pending[rid] = req
        log("extension UI request:", method, "->", (req.get("title") or "")[:80])
        self.broadcast(req)
        threading.Thread(target=self._ui_watchdog, args=(rid,), daemon=True).start()

    def _ui_watchdog(self, rid):
        """No question may hang a run forever. Wait for an answer, giving up
        sooner if nothing is connected that could possibly give one."""
        started = time.time()
        deadline = started + UI_TIMEOUT
        while time.time() < deadline:
            time.sleep(1.0)
            with self.lock:
                if rid not in self.ui_pending:
                    return
                watching = len(self.clients)
            if not watching and time.time() - started >= UI_NOUI_GRACE:
                self.resolve_ui(rid, cancelled=True,
                                why="no dashboard is connected to ask")
                return
        self.resolve_ui(rid, cancelled=True, why="nobody answered in time")

    def resolve_ui(self, rid, value=None, confirmed=None, cancelled=False, why=""):
        """Answer one pending dialog. Returns False if it is already gone, so a
        second tab cannot answer twice."""
        with self.lock:
            req = self.ui_pending.pop(rid, None)
        if req is None:
            return False
        resp = {"type": "extension_ui_response", "id": rid}
        if cancelled:
            resp["cancelled"] = True
        elif confirmed is not None:
            resp["confirmed"] = bool(confirmed)
        else:
            resp["value"] = value if value is not None else ""
        try:
            self.send_cmd(resp)
        except Exception as e:              # pi can die between ask and answer
            log("could not deliver the UI answer:", e)
        shown = "cancelled" if cancelled else (
            value if value is not None else str(confirmed))
        log("extension UI answered:", req.get("method"), "->", shown,
            *(("(" + why + ")",) if why else ()))
        self.broadcast({"type": "ui_resolved", "id": rid,
                        "method": req.get("method"),
                        "cancelled": bool(cancelled), "why": why,
                        "value": None if cancelled else value})
        return True

    def cancel_pending_ui(self, why):
        with self.lock:
            ids = list(self.ui_pending)
        for rid in ids:
            self.resolve_ui(rid, cancelled=True, why=why)

    def purge_trash(self):
        """Remove trashed transcripts older than TRASH_DAYS. Before that,
        recovery is an ordinary `mv`; after it, the nightly restic snapshot is
        the only copy left."""
        cutoff = time.time() - TRASH_DAYS * 86400
        purged = 0
        try:
            names = os.listdir(TRASH_DIR)
        except OSError:
            return 0
        for n in names:
            p = os.path.join(TRASH_DIR, n)
            try:
                if os.path.isfile(p) and os.path.getmtime(p) < cutoff:
                    os.remove(p)
                    purged += 1
                    log("TRASH PURGED:", p)
            except OSError as e:
                log("could not purge", p, e)
        return purged

    def run(self):
        self.start_pi()
        threading.Thread(target=self.read_fifo, daemon=True).start()
        threading.Thread(target=self.janitor, daemon=True).start()
        threading.Thread(target=self.usage_loop, daemon=True).start()
        self.start_web()
        threading.Thread(target=self._track_active_session, daemon=True).start()
        self.read_events()   # blocks until pi dies


class Handler(BaseHTTPRequestHandler):
    """HTTP + SSE control plane for the web dashboard."""
    d = None                       # Daemon instance, wired in start_web()

    def log_message(self, *args):  # silence per-request stderr noise
        pass

    # ---- helpers ----
    def _route(self):
        parsed = urllib.parse.urlsplit(self.path)
        return parsed.path, urllib.parse.parse_qs(parsed.query)

    def _authorized(self, qs):
        if not WEB_TOKEN:
            return True
        auth = (self.headers.get("Authorization") or "")
        if auth.startswith("Bearer "):
            auth = auth[7:]
        if auth == WEB_TOKEN:
            return True
        return qs.get("token", [None])[0] == WEB_TOKEN

    def _json(self, obj, status=200):
        body = json.dumps(obj).encode()
        self.send_response(status)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def _command(self, obj):
        try:
            resp = Handler.d.send_cmd_with_response(obj)
        except TimeoutError as e:
            self._json({"error": str(e)}, 504)
            return
        if resp.get("success") is False:
            self._json({"error": resp.get("error") or "command failed"}, 502)
            return
        data = resp.get("data")
        self._json(data if data is not None else {"ok": True})

    def _messages(self):
        try:
            resp = Handler.d.send_cmd_with_response({"type": "get_messages"})
        except TimeoutError as e:
            self._json({"error": str(e)}, 504)
            return
        data = resp.get("data") or {}
        msgs = data.get("messages", [])[-MSG_SNAPSHOT:]
        # A tool result is a TOP-LEVEL message with role "toolResult", not a
        # content block of that type. Replayed thinking dominates the payload
        # (105 KB of a measured 169 KB) and the page does not show old
        # reasoning; live thinking still streams over SSE.
        out = []
        for m in msgs:
            content = m.get("content")
            if not isinstance(content, list):
                out.append(m)       # a user message may carry a plain string
                continue
            blocks = []
            for x in content:
                if not isinstance(x, dict):
                    blocks.append(x)
                    continue
                if x.get("type") == "thinking":
                    continue
                if m.get("role") == "user" and x.get("type") == "text":
                    # Strip plumbing the daemon appends (Siri voice hint, the
                    # §15 attachment paths): the dashboard shows only what the
                    # user typed.
                    x = {**x, "text": _clean_user_text(x.get("text") or "")}
                if m.get("role") == "toolResult" and x.get("type") == "text":
                    t = x.get("text") or ""
                    if len(t) > TOOL_RESULT_CAP:
                        x = {**x, "text": t[:TOOL_RESULT_CAP] + "…"}
                blocks.append(x)
            out.append({**m, "content": blocks})
        self._json({"messages": out})

    def _sessions(self):
        """List session files in sessions/ and archive/ with sidebar metadata.
        The active one is flagged by comparing against get_state's sessionFile."""
        try:
            st = Handler.d.send_cmd_with_response({"type": "get_state"}, timeout=10)
            active = os.path.realpath((st.get("data") or {}).get("sessionFile") or "")
        except TimeoutError:
            active = ""
        items = []
        for which, root in (("sessions", SESSIONS_DIR), ("archive", ARCHIVE_DIR)):
            try:
                names = sorted(os.listdir(root))
            except OSError:
                continue
            for n in names:
                if not n.endswith(".jsonl"):
                    continue
                info = session_meta(os.path.join(root, n), which)
                if not info:
                    continue
                # B6: by path, not basename — the same name can exist in both
                # dirs, and flagging both would list one session twice.
                info["active"] = bool(active) and os.path.realpath(
                    os.path.join(root, n)) == active
                items.append(info)
        items.sort(key=lambda x: x.get("mtime") or 0, reverse=True)
        self._json({"sessions": items})

    def _session_read(self, qs):
        """Read one past session as a messages snapshot. Basename + dir
        allowlist only; realpath containment as a second belt."""
        fname = (qs.get("file") or [""])[0]
        which = (qs.get("dir") or ["sessions"])[0]
        if which not in ("sessions", "archive") \
                or fname != os.path.basename(fname) \
                or not fname.endswith(".jsonl"):
            self._json({"error": "bad request"}, 400)
            return
        root = os.path.realpath(SESSIONS_DIR if which == "sessions" else ARCHIVE_DIR)
        path = os.path.realpath(os.path.join(root, fname))
        if not path.startswith(root + os.sep) or not os.path.isfile(path):
            self._json({"error": "not found"}, 404)
            return
        try:
            self._json(session_messages(path))
        except OSError as e:
            self._json({"error": str(e)}, 500)

    def _media(self, subpath):
        """Serve a file from ATTACH_DIR (§15). realpath containment defeats both
        traversal and symlink escapes (review #5); GET only, auth as usual."""
        root = os.path.realpath(ATTACH_DIR)
        p = os.path.realpath(os.path.join(root, subpath))
        if p != root and not p.startswith(root + os.sep):
            self._json({"error": "not found"}, 404)
            return
        if not os.path.isfile(p):
            self._json({"error": "not found"}, 404)
            return
        try:
            with open(p, "rb") as f:
                body = f.read()
        except OSError:
            self._json({"error": "not found"}, 404)
            return
        ctype = mimetypes.guess_type(p)[0] or "application/octet-stream"
        self.send_response(200)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-cache")
        self.end_headers()
        self.wfile.write(body)

    def _serve_index(self):
        try:
            with open(INDEX_PATH, "rb") as f:
                body = f.read()
        except FileNotFoundError:
            body = (b"<html><body style='font-family:monospace'>"
                    b"web-agent: index.html not created yet (step 5)</body></html>")
        self.send_response(200)
        self.send_header("Content-Type", "text/html; charset=utf-8")
        self.send_header("Cache-Control", "no-cache")   # the page ships without
        # validators, so without this a browser may reuse a stale copy across
        # normal reloads and miss dashboard updates
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    # ---- routes ----
    def do_GET(self):
        path, qs = self._route()
        if not self._authorized(qs):
            self._json({"error": "unauthorized"}, 401)
            return
        if path == "/":
            self._serve_index()
        elif path == "/events":
            self._sse()
        elif path == "/state":
            self._command({"type": "get_state"})
        elif path == "/version":
            self._json(build_info())
        elif path == "/usage":
            with self.d.lock:
                snap = self.d.usage
            self._json(snap or {"error": "no usage snapshot yet"})
        elif path == "/ui":
            # So a page that loads (or reconnects) can still answer a question
            # that was asked while it was away.
            with self.d.lock:
                pending = list(self.d.ui_pending.values())
            self._json({"pending": pending})
        elif path == "/messages":
            self._messages()
        elif path == "/sessions":
            self._sessions()
        elif path == "/session":
            self._session_read(qs)
        elif path == "/models":
            self._command({"type": "get_available_models"})
        elif path.startswith("/media/"):
            self._media(urllib.parse.unquote(path[len("/media/"):]))
        else:
            self._json({"error": "not found"}, 404)

    def do_POST(self):
        path, qs = self._route()
        if not self._authorized(qs):
            self._json({"error": "unauthorized"}, 401)
            return
        try:
            n = int(self.headers.get("Content-Length") or 0)
            if n > MAX_BODY:
                self._json({"error": "body too large"}, 413)
                return
            body = json.loads(self.rfile.read(n).decode() or "{}")
        except Exception:
            body = {}
        if path == "/prompt":
            msg = (body.get("message") or "").strip()
            images = body.get("images") or []
            clean = []
            for im in images:
                if isinstance(im, dict) and im.get("type") == "image" and im.get("data"):
                    clean.append({
                        "type": "image",
                        "data": str(im["data"]),
                        "mimeType": im.get("mimeType") or "image/jpeg",
                    })
            if not msg and not clean:
                self._json({"error": "message required"}, 400)
                return
            if clean and not msg:
                msg = "What's in this image?"
            self._json(Handler.d.web_prompt(msg, clean or None))
        elif path == "/abort":
            Handler.d.send_cmd({"type": "clear_queue"})
            Handler.d.send_cmd({"type": "abort"})
            self._json({"status": "aborting"})
        elif path == "/model":
            try:
                resp = Handler.d.model_set(body.get("provider"), body.get("modelId"))
            except TimeoutError as e:
                self._json({"error": str(e)}, 504)
                return
            if resp.get("success") is False:
                self._json({"error": resp.get("error") or "set_model failed"}, 502)
                return
            self._json(resp.get("data") if resp.get("data") is not None else {"ok": True})
        elif path == "/newsession":
            try:
                self._json(Handler.d.switch_to_new(
                    archive=False, name=(body.get("name") or "").strip()[:80] or None))
            except Exception as e:
                log("newsession error:", e)
                self._json({"error": str(e)}, 500)
        elif path == "/archive":
            try:
                self._json(Handler.d.switch_to_new(
                    archive=True, name=(body.get("name") or "").strip()[:80] or None))
            except Exception as e:
                log("archive error:", e)
                self._json({"error": str(e)}, 500)
        elif path == "/opensession":
            # Resume an EXISTING transcript. Same basename + dir allowlist and
            # realpath containment as GET /session; pi does the switching.
            fname = (body.get("file") or "").strip()
            which = (body.get("dir") or "sessions").strip()
            if which not in ("sessions", "archive") \
                    or fname != os.path.basename(fname) \
                    or not fname.endswith(".jsonl"):
                self._json({"error": "bad request"}, 400)
                return
            root = os.path.realpath(SESSIONS_DIR if which == "sessions"
                                    else ARCHIVE_DIR)
            target = os.path.realpath(os.path.join(root, fname))
            if not target.startswith(root + os.sep) or not os.path.isfile(target):
                self._json({"error": "not found"}, 404)
                return
            # B4: an empty file becomes a new random-id session and a non-JSON
            # one makes pi throw, so neither is a resume target.
            if not _valid_session_file(target):
                self._json({"error": "not a resumable session file"}, 422)
                return
            try:
                res = Handler.d.open_session(target, unarchive=(which == "archive"))
                status = 200
                if isinstance(res, dict) and res.get("error"):
                    status = res.pop("status", 200)
                self._json(res, status)
            except Exception as e:
                log("opensession error:", e)
                self._json({"error": str(e)}, 500)
        elif path == "/deletesession":
            # Soft-delete a past transcript. Same basename + dir allowlist and
            # realpath containment as /opensession; the daemon refuses the live
            # session and anything it cannot move to trash/.
            fname = (body.get("file") or "").strip()
            which = (body.get("dir") or "sessions").strip()
            if which not in ("sessions", "archive") \
                    or fname != os.path.basename(fname) \
                    or not fname.endswith(".jsonl"):
                self._json({"error": "bad request"}, 400)
                return
            root = os.path.realpath(SESSIONS_DIR if which == "sessions"
                                    else ARCHIVE_DIR)
            target = os.path.realpath(os.path.join(root, fname))
            if not target.startswith(root + os.sep) or not os.path.isfile(target):
                self._json({"error": "not found"}, 404)
                return
            try:
                res = Handler.d.delete_session(target, which)
                status = 200
                if isinstance(res, dict) and res.get("error"):
                    status = res.pop("status", 200)
                self._json(res, status)
            except Exception as e:
                log("deletesession error:", e)
                self._json({"error": str(e)}, 500)
        elif path == "/ui_response":
            # The dashboard's answer to an extension dialog (§21). Idempotent:
            # a second tab that answers the same question is told it is gone
            # rather than sending pi a second response.
            rid = body.get("id")
            if not rid:
                self._json({"error": "id required"}, 400)
                return
            if body.get("cancelled"):
                done = Handler.d.resolve_ui(rid, cancelled=True,
                                            why="cancelled from the dashboard")
            elif "confirmed" in body:
                done = Handler.d.resolve_ui(rid, confirmed=bool(body["confirmed"]))
            else:
                done = Handler.d.resolve_ui(rid, value=body.get("value"))
            if done:
                self._json({"ok": True})
            else:
                self._json({"error": "no such request, or already answered"}, 409)
        elif path == "/sessionname":
            name = (body.get("name") or "").strip()[:80]
            if not name:
                self._json({"error": "name required"}, 400)
                return
            try:
                resp = Handler.d.send_cmd_with_response(
                    {"type": "set_session_name", "name": name}, timeout=10)
            except TimeoutError as e:
                self._json({"error": str(e)}, 504)
                return
            if resp.get("success") is False:
                self._json({"error": resp.get("error") or "set_session_name failed"}, 502)
                return
            log("session renamed:", name)
            self._json({"ok": True, "name": name})
        else:
            self._json({"error": "not found"}, 404)

    def _sse(self):
        q = queue.Queue(maxsize=200)
        d = Handler.d
        with d.clients_lock:
            d.clients.append(q)
        log("SSE client connected:", self.client_address[0])
        try:
            self.send_response(200)
            self.send_header("Content-Type", "text/event-stream")
            self.send_header("Cache-Control", "no-cache")
            self.send_header("X-Accel-Buffering", "no")
            self.end_headers()
            self.wfile.write(b"retry: 3000\n\n")
            self.wfile.flush()
            while True:
                try:
                    line = q.get(timeout=15)
                except queue.Empty:
                    self.wfile.write(b": ping\n\n")
                    self.wfile.flush()
                    continue
                try:
                    self.wfile.write(("data: " + line + "\n\n").encode())
                    self.wfile.flush()
                except (BrokenPipeError, ConnectionResetError):
                    break
        except (BrokenPipeError, ConnectionResetError):
            pass
        finally:
            with d.clients_lock:
                if q in d.clients:
                    d.clients.remove(q)
            log("SSE client disconnected:", self.client_address[0])


def main():
    # Keep daemon.log bounded.
    try:
        if os.path.exists(LOG) and os.path.getsize(LOG) > 5 * 1024 * 1024:
            os.replace(LOG, LOG + ".1")
    except OSError:
        pass

    d = Daemon()

    def _term(*_):
        log("received termination signal")
        try:
            if d.proc:
                d.proc.terminate()
        finally:
            sys.exit(0)

    signal.signal(signal.SIGTERM, _term)
    signal.signal(signal.SIGINT, _term)
    d.run()
    log("daemon exiting (pi process ended)")
    sys.exit(1)   # let systemd restart us


if __name__ == "__main__":
    main()
